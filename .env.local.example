# Copy to .env.local and fill in real values. Never commit .env or .env.local.

# Leave empty for same-origin API; set for external backend URL
NEXT_PUBLIC_API_URL=

# PostgreSQL connection string (required for Prisma)
DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require

# Kinde (https://app.kinde.com)
KINDE_CLIENT_ID=
KINDE_CLIENT_SECRET=
KINDE_ISSUER_URL=https://your-tenant.kinde.com
KINDE_SITE_URL=http://localhost:3000
KINDE_POST_LOGOUT_REDIRECT_URL=http://localhost:3000
KINDE_POST_LOGIN_REDIRECT_URL=http://localhost:3000/dashboard

# Public base URL for webhooks (e.g. ngrok HTTPS URL or production domain)
NEXT_PUBLIC_APP_URL=

# LLM provider API keys (server-only; set the ones you use)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
